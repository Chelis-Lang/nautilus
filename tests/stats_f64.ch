module Nautilus.Tests.StatsF64
import Nautilus.Stats (mean_vec, variance_vec, std_vec, skewness_vec, kurtosis_vec, median_vec, covariance_scalar, correlation_scalar, min_vec, max_vec, range_vec, quantile_vec, percentile_vec, trimmed_mean_vec, rank_vec, zscore_vec, bonferroni_adjust, stat_holm_adjust, benjamini_hochberg_adjust, fdr_adjust, likelihood_ratio_stat, covariance_2x2, correlation_2x2, covariance_matrix_2, correlation_matrix_2, covariance_matrix, correlation_matrix)
import Std.Test (assert_close, assert_close_tensor)
-- Every Float-generic Nautilus.Stats export called at f64 (nautilus#69).
-- Each input is chosen so f32 arithmetic misses the expected value by far
-- more than the tolerance: offsets around 1e8 collapse in f32, and p-values
-- carry digits below f32 precision. A pass therefore shows the computation
-- ran in f64. It does not merely show the call typechecks.
-- Expected values come from numpy/scipy float64.
-- likelihood_ratio_p_value is the one f32 residue; see tests_neg/stats/p_value_f64_neg.
def test_f64_mean_vec() -> unit ! { Test } = assert_close(mean_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64])), 100000003.25f64, 1e-6f64, "mean at f64 resolves 1e8 offsets; f32 arithmetic misses this by at least 1.0")
def test_f64_variance_vec_pop() -> unit ! { Test } = assert_close(variance_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), 0i64), 5.1875f64, 1e-6f64, "population variance at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_variance_vec_samp() -> unit ! { Test } = assert_close(variance_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), 1i64), 6.916666666666667f64, 1e-6f64, "sample variance at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_std_vec() -> unit ! { Test } = assert_close(std_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), 0i64), 2.277608394786075f64, 1e-6f64, "population std at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_skewness_vec() -> unit ! { Test } = assert_close(skewness_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64])), 0.8331504071506617f64, 1e-6f64, "skewness at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_kurtosis_vec() -> unit ! { Test } = assert_close(kurtosis_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64])), -0.9020177093917838f64, 1e-6f64, "excess kurtosis at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_median_vec() -> unit ! { Test } = assert_close(median_vec(to_tensor([100000003.0f64, 100000001.0f64, 100000002.0f64])), 100000002.0f64, 1e-6f64, "median at f64 separates 1e8+1..1e8+3; f32 arithmetic misses this by at least 1.0")
def test_f64_covariance_scalar() -> unit ! { Test } = assert_close(covariance_scalar(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), to_tensor([100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64]), 0i64), 4.6875f64, 1e-6f64, "scalar covariance at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_correlation_scalar() -> unit ! { Test } = assert_close(correlation_scalar(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), to_tensor([100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64])), 0.8629815702089605f64, 1e-6f64, "Pearson r at f64; f32 arithmetic gives 0.707")
def test_f64_min_vec() -> unit ! { Test } = assert_close(min_vec(to_tensor([100000002.0f64, 100000001.0f64, 100000003.0f64])), 100000001.0f64, 1e-6f64, "min at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_max_vec() -> unit ! { Test } = assert_close(max_vec(to_tensor([100000002.0f64, 100000001.0f64, 100000003.0f64])), 100000003.0f64, 1e-6f64, "max at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_range_vec() -> unit ! { Test } = assert_close(range_vec(to_tensor([100000002.0f64, 100000001.0f64, 100000003.0f64])), 2.0f64, 1e-6f64, "range at f64 is 2; f32 arithmetic gives 0")
def test_f64_quantile_vec() -> unit ! { Test } = assert_close(quantile_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), 0.25f64), 100000001.75f64, 1e-6f64, "quantile at f64 interpolates across 1e8 offsets; f32 arithmetic misses this by at least 1.0")
def test_f64_percentile_vec() -> unit ! { Test } = assert_close(percentile_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), 75.0f64), 100000004.0f64, 1e-6f64, "percentile at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_trimmed_mean_vec() -> unit ! { Test } = assert_close(trimmed_mean_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000004.0f64, 100000100.0f64, 99999900.0f64, 100000005.0f64, 100000006.0f64]), 0.25f64), 100000003.5f64, 1e-6f64, "trimmed mean at f64 exercises the chelis#2151 truncation helper; f32 arithmetic misses this by at least 1.0")
def test_f64_rank_vec() -> unit ! { Test } = assert_close_tensor(rank_vec(to_tensor([100000002.0f64, 100000001.0f64, 100000003.0f64])), to_tensor([2.0f64, 1.0f64, 3.0f64]), 0.0f64, "ranks at f64 separate 1e8+1..1e8+3; f32 arithmetic ties all three")
def test_f64_zscore_vec() -> unit ! { Test } = assert_close_tensor(zscore_vec(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64]), 0i64), to_tensor([-1.224744871391589f64, 0.0f64, 1.224744871391589f64]), 1e-6f64, "zscore at f64; f32 arithmetic returns NaN from zero spread")
def test_f64_bonferroni_adjust() -> unit ! { Test } = assert_close_tensor(bonferroni_adjust(to_tensor([0.0100000001f64, 0.0400000003f64, 0.0300000002f64])), to_tensor([0.0300000003f64, 0.12000000089999999f64, 0.0900000006f64]), 1e-12f64, "Bonferroni at f64 keeps the 1e-10 p-value digits")
def test_f64_stat_holm_adjust() -> unit ! { Test } = assert_close_tensor(stat_holm_adjust(to_tensor([0.0100000001f64, 0.0400000003f64, 0.0300000002f64])), to_tensor([0.0300000003f64, 0.0600000004f64, 0.0600000004f64]), 1e-12f64, "Holm at f64 keeps the 1e-10 p-value digits")
def test_f64_benjamini_hochberg_adjust() -> unit ! { Test } = assert_close_tensor(benjamini_hochberg_adjust(to_tensor([0.0100000001f64, 0.0400000003f64, 0.0300000002f64])), to_tensor([0.0300000003f64, 0.0400000003f64, 0.0400000003f64]), 1e-12f64, "BH at f64 keeps the 1e-10 p-value digits")
def test_f64_fdr_adjust() -> unit ! { Test } = assert_close_tensor(fdr_adjust(to_tensor([0.0100000001f64, 0.0400000003f64, 0.0300000002f64])), to_tensor([0.0300000003f64, 0.0400000003f64, 0.0400000003f64]), 1e-12f64, "fdr_adjust at f64 aliases BH")
def test_f64_likelihood_ratio_stat() -> unit ! { Test } = assert_close(likelihood_ratio_stat(-12.000000001f64, -10.0f64), 4.000000002f64, 1e-12f64, "LR statistic at f64 keeps the 1e-9 digit")
def test_f64_covariance_2x2() -> unit ! { Test } = assert_close_tensor(covariance_2x2(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), to_tensor([100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64]), 0i64), to_tensor([[5.1875f64, 4.6875f64], [4.6875f64, 5.6875f64]]), 1e-6f64, "covariance_2x2 at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_covariance_matrix_2() -> unit ! { Test } = assert_close_tensor(covariance_matrix_2(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), to_tensor([100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64]), 0i64), to_tensor([[5.1875f64, 4.6875f64], [4.6875f64, 5.6875f64]]), 1e-6f64, "covariance_matrix_2 alias at f64")
def test_f64_correlation_2x2() -> unit ! { Test } = assert_close_tensor(correlation_2x2(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), to_tensor([100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64])), to_tensor([[1.0f64, 0.8629815702089606f64], [0.8629815702089607f64, 1.0f64]]), 1e-6f64, "correlation_2x2 at f64; f32 arithmetic gives 0.577")
def test_f64_correlation_matrix_2() -> unit ! { Test } = assert_close_tensor(correlation_matrix_2(to_tensor([100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64]), to_tensor([100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64])), to_tensor([[1.0f64, 0.8629815702089606f64], [0.8629815702089607f64, 1.0f64]]), 1e-6f64, "correlation_matrix_2 alias at f64")
def test_f64_covariance_matrix() -> unit ! { Test } = assert_close_tensor(covariance_matrix(to_tensor([[100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64], [100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64]]), 0i64), to_tensor([[5.1875f64, 4.6875f64], [4.6875f64, 5.6875f64]]), 1e-6f64, "general covariance_matrix at f64; f32 arithmetic misses this by at least 1.0")
def test_f64_correlation_matrix() -> unit ! { Test } = assert_close_tensor(correlation_matrix(to_tensor([[100000001.0f64, 100000002.0f64, 100000003.0f64, 100000007.0f64], [100000002.0f64, 100000004.0f64, 100000007.0f64, 100000008.0f64]])), to_tensor([[1.0f64, 0.8629815702089606f64], [0.8629815702089607f64, 1.0f64]]), 1e-6f64, "general correlation_matrix at f64; f32 arithmetic gives 0.577")
