}
def gauss_legendre_5(f: f32 -> f32, a: f32, b: f32, n_points: i64) -> f32 = {
  ignore_n = n_points
  half_range = cast(0.5, f32) |> mul(sub(b, a))
  mid = cast(0.5, f32) |> mul(add(a, b))
  x1_t = mul(half_range, cast(-0.906179845938664, f32))
  x1 = add(mid, x1_t)
  x2_t = mul(half_range, cast(-0.5384693101056831, f32))
  x2 = add(mid, x2_t)
  x3 = mid
  x4_t = mul(half_range, cast(0.5384693101056831, f32))
  x4 = add(mid, x4_t)
  x5_t = mul(half_range, cast(0.906179845938664, f32))
  x5 = add(mid, x5_t)
  f1 = f(x1)
  f2 = f(x2)
  f3 = f(x3)
  f4 = f(x4)
  f5 = f(x5)
  w1 = cast(0.2369268850561891, f32)
  w2 = cast(0.4786286704993665, f32)
  w3 = cast(0.5688888888888889, f32)
  w4 = cast(0.4786286704993665, f32)
  w5 = cast(0.2369268850561891, f32)
  s1 = mul(w1, f1)
  s2 = mul(w2, f2)
  s3 = mul(w3, f3)
  s4 = mul(w4, f4)
  s5 = mul(w5, f5)
  sum12 = add(s1, s2)
  sum34 = add(s3, s4)
  sum1234 = add(sum12, sum34)
  total = add(sum1234, s5)
  mul(half_range, total)
}
